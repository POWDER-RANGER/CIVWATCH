# ── App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4000

# ── PostgreSQL
DATABASE_URL=postgresql://civwatch:civwatch@localhost:5432/civwatch

# ── Redis
REDIS_URL=redis://localhost:6379

# ── JWT
JWT_SECRET=change_me_before_production_use_32chars_min
JWT_EXPIRES_IN=7d

# ── Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── ML Service
ML_SERVICE_URL=http://localhost:5000
