# DO NOT COMMIT REAL VALUES
# Copy this file to .env and fill in your actual API keys
# This file is intentionally reset for security

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/civwatch

# API Keys (replace with your own)
FEC_API_KEY=your_fec_api_key_here
CONGRESS_API_KEY=your_congress_api_key_here
OPENFEC_API_KEY=your_openfec_api_key_here

# Security
JWT_SECRET=change_this_to_a_random_string
ENCRYPTION_KEY=change_this_to_a_32_byte_key

# Services
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Feature Flags
ENABLE_SCRAPING=false
ENABLE_ML=false

# Environment
NODE_ENV=development
PORT=3000
