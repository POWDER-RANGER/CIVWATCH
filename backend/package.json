{
  "name": "civwatch-backend",
  "version": "0.1.0",
  "description": "CIVWATCH backend API service",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest --forceExit --preset ts-jest --testEnvironment node --testPathIgnorePatterns tests/integration",
    "lint": "eslint src",
    "validate:env": "ts-node src/config/env.ts",
    "seed": "ts-node src/db/seed.ts",
    "test:integration": "jest --forceExit --preset ts-jest --testEnvironment node tests/integration"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "redis": "^6.3.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
