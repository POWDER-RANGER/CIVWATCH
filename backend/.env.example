# ═══════════════════════════════════════════════════════════
# CIVWATCH Backend — Environment Variable Template
# Copy this file: cp backend/.env.example backend/.env
# NEVER commit the actual .env file
# ═══════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────
# Required: PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://civwatch:devpassword123@localhost:5432/civwatch

# ── Redis ───────────────────────────────────────────────────
# Required: Redis URL for caching and job queues
REDIS_URL=redis://localhost:6379

# ── Authentication ──────────────────────────────────────────
# Required: JWT signing secret — MINIMUM 32 characters
# SECURITY: Generate a unique key per environment
# Command: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_RUN_openssl_rand_base64_32
JWT_EXPIRATION=24h

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Log level: error | warn | info | debug
LOG_LEVEL=info

# ── CORS ────────────────────────────────────────────────────
# Comma-separated allowed origins. NEVER use * in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── ML Service ──────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:5000

# ── External APIs ───────────────────────────────────────────
# Optional: OpenAI API key for GPT-based analysis (M2+)
OPENAI_API_KEY=sk-replace-with-your-key

# ── Webhooks ────────────────────────────────────────────────
# Optional: Outbound webhook for alert notifications
WEBHOOK_URL=https://your-webhook-endpoint.example.com/notify
# SECURITY: HMAC secret for validating inbound webhook signatures
WEBHOOK_SECRET=replace-with-strong-random-secret

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
