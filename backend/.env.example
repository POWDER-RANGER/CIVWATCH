# =============================================================================
# CIVWATCH BACKEND - Environment Configuration
# =============================================================================
# Copy this file: cp backend/.env.example backend/.env
# NEVER commit .env files — they are in .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required: PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://civwatch:devpassword@localhost:5432/civwatch

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Required: Redis connection URL for caching and job queues
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Required: Secret key for JWT signing (minimum 32 characters)
# SECURITY: Generate a unique key per environment
# Command:  openssl rand -base64 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND

# Optional: JWT token expiration (default: 24h)
JWT_EXPIRATION=24h

# ---------------------------------------------------------------------------
# API Keys
# ---------------------------------------------------------------------------
# Optional: OpenAI API key (required only for GPT-based ML features)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port for backend API server (default: 3000)
PORT=3000

# Environment: development | staging | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
# Time window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per IP per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins
# SECURITY: Never use * in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# ML Service
# ---------------------------------------------------------------------------
# Internal URL for ML service communication
ML_SERVICE_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
# Optional: Webhook notification URL for outbound alerts
WEBHOOK_URL=https://your-webhook-endpoint.com/notify

# Optional: HMAC signature secret for webhook verification
# SECURITY: Use a strong random value in production
WEBHOOK_SECRET=your-webhook-secret-here
