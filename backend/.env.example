# Environment example for CIVWATCH

# Server
PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/civwatch

# JWT (RSA PEM strings) - do NOT commit keys
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# OpenLineage
OPENLINEAGE_URL=http://openlineage:5000/api/v1/lineage

# CORS
CORS_ORIGINS=http://localhost:3000

# Metrics
METRICS_TOKEN=changeme

# Feature flags
FEATURE_FLAGS=

# ML
ML_SERVICE_URL=http://ml-service:8000
