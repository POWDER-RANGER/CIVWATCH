# ═══════════════════════════════════════════════════════════
# CIVWATCH Frontend — Environment Variable Template
# Copy this file: cp frontend/.env.example frontend/.env
# Variables prefixed with VITE_ are exposed to the browser
# ═══════════════════════════════════════════════════════════

# ── API ─────────────────────────────────────────────────────
# Required: Backend API base URL
VITE_API_BASE_URL=http://localhost:3000/api

# Optional: WebSocket URL for real-time alert updates
VITE_WS_URL=ws://localhost:3000

# ── Dev Server ──────────────────────────────────────────────
VITE_PORT=5173

# ── Feature Flags ───────────────────────────────────────────
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_PANEL=false
VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# ── Monitoring ──────────────────────────────────────────────
# Optional: Sentry DSN for frontend error tracking
VITE_SENTRY_DSN=
