# ═══════════════════════════════════════════════════════════
# CIVWATCH ML Service — Environment Variable Template
# Copy this file: cp ml/.env.example ml/.env
# ═══════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=5000
LOG_LEVEL=INFO

# ── Model ───────────────────────────────────────────────────
# MVP: textblob | M2+: transformers-distilbert | openai-gpt
SENTIMENT_MODEL=textblob
MODEL_DIR=./models

# ── GPU ─────────────────────────────────────────────────────
USE_GPU=false
CUDA_VISIBLE_DEVICES=0

# ── Inference ───────────────────────────────────────────────
INFERENCE_TIMEOUT=30
MAX_BATCH_SIZE=32

# ── Optional External Keys ──────────────────────────────────
# HuggingFace token for downloading gated models
HUGGINGFACE_TOKEN=
# OpenAI key if using GPT-based analysis
OPENAI_API_KEY=sk-replace-with-your-key

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
