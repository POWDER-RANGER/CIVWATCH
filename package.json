{
  "name": "civwatch",
  "version": "0.1.0",
  "description": "Next-Generation Civic Surveillance & Transparency Platform",
  "keywords": [
    "civic-tech",
    "transparency",
    "democracy",
    "surveillance",
    "accountability"
  ],
  "homepage": "https://github.com/POWDER-RANGER/CIVWATCH#readme",
  "bugs": {
    "url": "https://github.com/POWDER-RANGER/CIVWATCH/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/POWDER-RANGER/CIVWATCH.git"
  },
  "license": "MIT",
  "author": "POWDER-RANGER",
  "workspaces": [
    "frontend",
    "backend",
    "ml"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:ai": "cd ml && python -m uvicorn main:app --reload",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "install:all": "npm install && cd ml && pip install -r requirements.txt"
  },
  "devDependencies": {
    "@types/node": "^20.19.26",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "typescript": "^5.9.3"
    "prettier": "^3.7.4",
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
